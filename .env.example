# URL de conexão com o banco SQLite (Prisma)
DATABASE_URL="file:./prisma/dev.db"

# Chave secreta para assinar os tokens de acesso JWT (troque por uma string longa e aleatória)
JWT_SECRET="sua_chave_secreta_muito_segura_aqui"

# Chave secreta para assinar os refresh tokens (deve ser DIFERENTE do JWT_SECRET)
JWT_REFRESH_SECRET="sua_chave_refresh_secreta_e_diferente_aqui"

# Tempo de expiração do token JWT (ex: 1h, 7d, 30d)
JWT_EXPIRES_IN="7d"

# Porta em que o servidor vai rodar
PORT=3000
